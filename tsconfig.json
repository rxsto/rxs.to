{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client", "@cloudflare/workers-types"]
  },
  "include": ["next-env.d.ts", "app", "components", "server", "shared", "tests", "tools", "worker-env.d.ts", "vite.config.ts"]
}
