{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rxs-to",
  "workers_dev": true,
  "kv_namespaces": [
    { "binding": "KV", "id": "0e441d7fec3e4b848dbf6937e263f450" }
  ],
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "server/worker.ts",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  }
}
